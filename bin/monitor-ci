#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

function usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] [COMMIT]

Monitor CI status for a git commit and notify when complete.

Arguments:
  COMMIT    Git commit, branch, or ref to monitor (default: current branch)

Options:
  -h, --help        Show this help message and exit
  -a, --all         Wait for all checks, not just required ones

Environment variables:
  SAY_DONE      If set, speaks "done" when CI completes

Examples:
  $(basename "$0")              # Monitor current branch
  $(basename "$0") main         # Monitor required checks on main
  $(basename "$0") -a           # Monitor all checks (including optional)
  $(basename "$0") -a main      # Monitor all checks on main
EOF
}

all=false
while [[ "${1:-}" == -* ]]; do
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    -a|--all) all=true; shift ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

function print() {
  echo "$(date +"%Y-%m-%dT%H:%M:%S") $1"
}

commit="${1:-"$(git rev-parse --abbrev-ref HEAD)"}"

# If a branch arg was given, verify it exists on GitHub
if [[ -n "${1:-}" ]]; then
  if ! gh api "repos/{owner}/{repo}/branches/$commit" >/dev/null 2>&1; then
    echo "error: branch '$commit' does not exist on GitHub. Use the branch." >&2
    exit 1
  fi
fi

function notify() {
  local status="$1"
  print "$status"
  osascript -e "display notification \"$commit done: $status\" with title \"monitor-ci\""
  if [ -n "${SAY_DONE+x}" ]; then
    say 'done'
  fi
  tput bel
}

if $all; then
  print "Monitoring $commit (all checks)..."
  while true
  do
    if [ "$commit" == "" ]
    then
      status=$(hub ci-status || true)
    else
      status=$(hub ci-status "$commit" || true)
    fi
    if [ "$status" != "pending" ]
    then
      notify "$status"
      break
    fi
    sleep 20
  done
else
  print "Monitoring $commit (required checks only)..."
  gh pr checks "$commit" --required --watch --fail-fast --interval 20 && status="success" || status="failure"
  notify "$status"
fi
